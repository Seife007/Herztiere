# Kopieren nach .env und Werte anpassen. .env wird nicht committet.

# --- Datenbank ---
POSTGRES_USER=herztiere
POSTGRES_PASSWORD=change-me
POSTGRES_DB=herztiere
POSTGRES_PORT=5432
# Für lokale Ausführung außerhalb von docker-compose auf "localhost" setzen,
# innerhalb von docker-compose auf den Servicenamen "db".
DATABASE_URL=postgres://herztiere:change-me@localhost:5432/herztiere

# --- Backend ---
PORT=3000
# Kommagetrennte Liste erlaubter Origins für CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Erster Admin-Account (siehe Seed-Script aus Issue #2). Nur beim ersten Seed
# relevant, danach können weitere Admins über den Admin-Bereich verwaltet werden.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Gültigkeitsdauer eines "Passwort vergessen"-Links in Minuten
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Basis-URL des Frontends, wird für den Link in der Reset-Mail verwendet
FRONTEND_URL=http://localhost:5173
# Es ist noch kein echter E-Mail-Versand (SMTP) angebunden - der Reset-Link
# wird bis dahin auf der Backend-Konsole geloggt (siehe memory.md).

# --- Sync-Crawler (Issue #3) ---
# Quelle: Fundtiere Wien (Stadt Wien), CC BY 4.0 - siehe docs/data-source.md
FUNDTIERE_FEED_URL=https://www.wien.gv.at/fundundvergabetiere/internet/rssfeed.xml
FUNDTIERE_IMAGE_BASE_URL=https://www.wien.gv.at
SYNC_USER_AGENT=herztiere/0.1 (Kontakt: f.draxl@gmail.com)
# Verzeichnis für lokal gecachte Bilder, relativ zum Arbeitsverzeichnis des
# Backend-Prozesses (in docker-compose als Volume gemountet, siehe unten).
IMAGE_STORAGE_DIR=storage/images

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
